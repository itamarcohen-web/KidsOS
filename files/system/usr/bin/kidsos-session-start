#!/usr/bin/bash
# Autostarted at the beginning of every normal (non-setup) KidsOS
# session, once account creation has already happened via the
# kidsos-setup session (see docs/ACCOUNTS_AND_LOGIN.md). Branches on the
# real Linux group membership established at account creation — not a
# flag file — to decide what the logged-in account sees:
#
#   Parent (wheel member):    normal Plasma desktop, unmodified, plus a
#                              small "Parent Mode" indicator (spec §12).
#   Child (kidsos-children):  the full-screen KidsOS desktop shell.
set -euo pipefail

if id -nG "${USER}" | tr ' ' '\n' | grep -qx "wheel"; then
    exec /usr/bin/kidsos-parent-indicator
else
    exec /usr/bin/kidsos-launcher
fi
