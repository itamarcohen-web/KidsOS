[Unit]
Description=Create the KidsOS child account on first boot
ConditionPathExists=!/var/lib/kidsos/firstboot-done
After=systemd-remount-fs.service
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/kidsos/create-child-account.sh
ExecStartPost=/usr/bin/mkdir -p /var/lib/kidsos
ExecStartPost=/usr/bin/touch /var/lib/kidsos/firstboot-done

[Install]
WantedBy=multi-user.target
